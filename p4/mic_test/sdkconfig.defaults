## Waveshare ESP32-P4-ETH (ESP32-P4NRW32X: 32 MB flash, 32 MB hex PSRAM).
CONFIG_IDF_TARGET="esp32p4"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Console: the Type-C is a WCH CH340 USB-UART bridge wired to UART0
# (VID 1a86), NOT the native USB-Serial-JTAG - so use the UART0 console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# PSRAM for the 30 s stereo capture buffer (~1.9 MB).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Default single-app partition table is enough (no model partition).
